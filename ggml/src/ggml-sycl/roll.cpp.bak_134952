#include <cstdio>
#include <chrono>
#include "common.hpp"
using namespace sycl;
static inline size_t off_bytes(const ggml_tensor * t, int64_t i0, int64_t i1, int64_t i2, int64_t i3) {
    return (size_t)i0 * t->nb[0] + (size_t)i1 * t->nb[1] + (size_t)i2 * t->nb[2] + (size_t)i3 * t->nb[3];
}
static void kernel_roll_impl(queue &q, const ggml_tensor *src, ggml_tensor *dst, int axis, int64_t shift) {
    const int64_t ne0 = dst->ne[0], ne1 = dst->ne[1], ne2 = dst->ne[2], ne3 = dst->ne[3];
    const int64_t len = dst->ne[axis];
    const int64_t sh  = ((shift % len) + len) % len;

    char * __restrict d_dst = (char*) dst->data;
    const char * __restrict d_src = (const char*) src->data;
    const size_t elem_size = ggml_type_size(dst->type);

    q.submit([&](handler &h) {
        h.parallel_for(range<3>(ne3, ne2, ne1*ne0), [=](id<3> idx) {
            int64_t i3 = idx[0], i2 = idx[1], flat01 = idx[2];
            int64_t i1 = flat01 / ne0, i0 = flat01 % ne0;
            int64_t s0=i0, s1=i1, s2=i2, s3=i3;
            if (axis==0) s0 = (i0 - sh + ne0) % ne0;
            if (axis==1) s1 = (i1 - sh + ne1) % ne1;
            if (axis==2) s2 = (i2 - sh + ne2) % ne2;
            if (axis==3) s3 = (i3 - sh + ne3) % ne3;
            size_t off_src = off_bytes(src, s0, s1, s2, s3);
            size_t off_dst = off_bytes(dst, i0, i1, i2, i3);
            for (size_t b=0;b<elem_size;++b) d_dst[off_dst+b] = d_src[off_src+b];
        });
    });
    q.wait();
}
void ggml_sycl_roll(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
    ggml_tensor *src = dst->src[0];
    const int axis = (int) dst->op_params[0];
    const int64_t shift = (int64_t) dst->op_params[1];
    kernel_roll_impl(*ctx.stream(), src, dst, axis, shift);
}

// ===== TEMP PROBE for manual A/B test =====
extern "C" void ggml_sycl_roll_probe(ggml_tensor * src, ggml_tensor * dst, int axis, long long shift) {
    try {
        sycl::queue q{ sycl::gpu_selector_v };
        auto t0 = std::chrono::steady_clock::now();
        kernel_roll_impl(q, src, dst, axis, (int64_t)shift);
        q.wait();
        auto t1 = std::chrono::steady_clock::now();
        double ms = std::chrono::duration<double,std::milli>(t1 - t0).count();
        std::printf("[ROLL-PROBE] axis=%d shift=%lld elapsed=%.3f ms\n", axis, shift, ms);
    } catch (const std::exception &e) {
        std::fprintf(stderr, "[ROLL-PROBE] exception: %s\n", e.what());
    }
}
