#include <sycl/sycl.hpp>
#include <cstring>
#include "ggml.h"
#include "common.hpp"

using namespace sycl;

static inline size_t off_bytes(const ggml_tensor * t,
                               int64_t i0, int64_t i1, int64_t i2, int64_t i3) {
    return (size_t)i0 * t->nb[0] +
           (size_t)i1 * t->nb[1] +
           (size_t)i2 * t->nb[2] +
           (size_t)i3 * t->nb[3];
}

static void kernel_roll_impl(queue &q,
                             const ggml_tensor *src,
                             ggml_tensor *dst,
                             int axis, int shift) {
    const int64_t ne0 = dst->ne[0];
    const int64_t ne1 = dst->ne[1];
    const int64_t ne2 = dst->ne[2];
    const int64_t ne3 = dst->ne[3];
    const int64_t len = dst->ne[axis];
    const int64_t sh  = ((shift % len) + len) % len;
    const size_t elem_size = ggml_type_size(dst->type);
    const size_t total_elems = ne0 * ne1 * ne2 * ne3;
    const size_t total_bytes = total_elems * elem_size;

    // --- הקצאת זיכרון משותף בין CPU ו־GPU ---
    float *src_shared = (float*)malloc_shared(total_bytes, q);
    float *dst_shared = (float*)malloc_shared(total_bytes, q);
    std::memcpy(src_shared, src->data, total_bytes);

    // --- הפעלת ה־kernel על ה־GPU ---
    q.submit([&](handler &h) {
        h.parallel_for(range<3>(ne3, ne2, ne1), [=](id<3> idx) {
            int64_t i3 = idx[0];
            int64_t i2 = idx[1];
            int64_t i1 = idx[2];
            for (int64_t i0 = 0; i0 < ne0; ++i0) {
                int64_t s0=i0, s1=i1, s2=i2, s3=i3;
                if (axis==0) s0 = (i0 - sh + ne0) % ne0;
                if (axis==1) s1 = (i1 - sh + ne1) % ne1;
                if (axis==2) s2 = (i2 - sh + ne2) % ne2;
                if (axis==3) s3 = (i3 - sh + ne3) % ne3;
                size_t src_idx = ((s3*ne2 + s2)*ne1 + s1)*ne0 + s0;
                size_t dst_idx = ((i3*ne2 + i2)*ne1 + i1)*ne0 + i0;
                dst_shared[dst_idx] = src_shared[src_idx];
            }
        });
    }).wait();

    // --- העתקת התוצאה חזרה ל־CPU ---
    std::memcpy(dst->data, dst_shared, total_bytes);

    free(src_shared);
    free(dst_shared);
}

extern "C" void ggml_sycl_roll(ggml_tensor * dst, const ggml_tensor * src, int axis, int shift) {
    sycl::queue q{ sycl::gpu_selector_v };
    kernel_roll_impl(q, src, dst, axis, shift);
}

extern "C" void ggml_sycl_roll_probe(ggml_tensor * src,
                                     ggml_tensor * dst,
                                     int axis,
                                     long long shift) {
    // shim: קוראת למימוש החדש
    ggml_sycl_roll(dst, src, axis, (int)shift);
}
